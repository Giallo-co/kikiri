# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (SQL/RDS)
# ==========================================
# Usado por Prisma y el adaptador MariaDB
# Formato Local: mysql://root:root@localhost:3306/kikiri_db
# Formato RDS: mysql://admin:password@rds-host:3306/kikiri_db
DATABASE_URL="mysql://root:root@localhost:3306/social-media"

# ==========================================
# CONFIGURACIÓN DE AWS / DYNAMODB
# ==========================================
# Región de AWS donde reside tu tabla y tu instancia EC2
AWS_REGION="us-east-1"

# Nombre de la tabla única (Single Table Design). Posts del feed y user-posts comparten esta tabla (PK/SK + GSI1/GSI2).
DYNAMODB_TABLE_NAME="KikiriSocial"

# Opcional / heredado: ya no hace falta una tabla aparte; user-posts escriben en DYNAMODB_TABLE_NAME.
# DYNAMODB_USER_POST_TABLE_NAME="KikiriSocial"

# --- SOLO PARA DESARROLLO LOCAL ---
# Estas variables deben estar comentadas en el .example.
# En local, se usan para conectar con el contenedor de dynamodb-local.
# En producción (EC2), NO se deben definir para que el SDK use el IAM Role de la instancia.
# DYNAMODB_ENDPOINT="http://localhost:8000"
# AWS_ACCESS_KEY_ID="local"
# AWS_SECRET_ACCESS_KEY="local"

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# Configuración de URLs para logs y redirecciones
HOST=localhost
PROTOCOL=http
API_BASE_PATH=/user

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
# Clave para firmar los tokens de sesión
JWT_SECRET_KEY=cambiame_por_una_cadena_larga_y_aleatoria
MIN_PASSWORD_LENGTH=8

# ==========================================
# OTROS (S3)
# ==========================================
ERROR_MESSAGE="Something broke!"

S3_BUCKET_NAME=
# Optional: no trailing slash; used to build public URLs for img/audio tags
S3_PUBLIC_BASE_URL=