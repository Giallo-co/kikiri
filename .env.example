# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Conexión a la Base de Datos
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root:root@localhost:3306/social-media"

# Variables para la aplicación
# Puerto del servidor
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Mínimo de longitud de password al registrar
MIN_PASSWORD_LENGTH=8

# Prefijo/base path de las rutas del API de usuario
# Ej: /user, /api/v1/user
API_BASE_PATH=/user

# Host y protocolo usados para el log/URL (y para despliegue)
HOST=localhost
PROTOCOL=http

# Mensaje genérico para errores 500
ERROR_MESSAGE=Something broke!

# Clave secreta super segura para JWT
JWT_SECRET_KEY=clave_secreta_super_segura

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
DYNAMODB_TABLE_NAME=UserPosts
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key