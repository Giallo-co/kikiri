{
  "name": "kikiri",
  "version": "1.0.0",
  "description": "Plataforma social orientada a compartir, acceder y comentar sobre musica de pequeños creadores.",
  "homepage": "https://github.com/Giallo-co/kikiri#readme",
  "bugs": {
    "url": "https://github.com/Giallo-co/kikiri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Giallo-co/kikiri.git"
  },
  "license": "ISC",
  "author": "Giallo co.",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npx prisma generate && tsc",
    "prestart": "npx prisma migrate deploy",
    "start": "node ./dist/app.js",
    "test": "jest --config=jest.config.cjs",
    "pre:setup": "bash ./scripts/setup.sh",
    "test:backend": "npm run pre:setup && npm run test",
    "dev:backend": "npm run pre:setup && ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:frontend": "npm run dev --workspace=frontend",
    "crud:dynamo": "ts-node src/lib/aws/dynamo/crud.ts",
    "crud:s3": "ts-node src/lib/aws/s3/crud.ts",
    "dev:all": "npm run pre:setup && concurrently \"ts-node-dev --respawn --transpile-only src/app.ts\" \"npm run dev --workspace=frontend\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@prisma/adapter-mariadb": "^7.4.2",
    "@prisma/client": "^7.5.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.5.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/test-sequencer": "^30.2.0",
    "@prisma/config": "^7.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "concurrently": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
